# ── Server ───────────────────────────────────────────────
PORT=3000
# Long random string used to sign session cookies. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Set to "true" only behind HTTPS (production). Leave false for local http.
SECURE_COOKIES=false

# ── Source sheet (read-only) ─────────────────────────────
SPREADSHEET_ID=15hU9z9N8xjyUCsUFRpD5ybEs3VYNbiU-LTRqYocxdYE
# Exact name of the tab to read. Must match the sheet's tab label.
PEOPLEBOX_TAB=Peoplebox
# How long (seconds) to cache a sheet read before re-fetching.
CACHE_TTL_SECONDS=300

# ── Service account (Sheets API, read-only) ──────────────
# Path to the service-account JSON key file. The service account's email
# must be granted Viewer access to the spreadsheet.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# Alternative to the key file: paste the JSON as a single-line env var instead.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Google OAuth (user sign-in / SSO) ────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Must exactly match an Authorized redirect URI in the OAuth client.
OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Comma-separated list of email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=sprout.ph,peoplebox.ai
# Optional: comma-separated individual emails allowed in addition to the domains.
ALLOWED_EMAILS=

# ── RADAR (Databricks) — powers the "Peoplebox Subscriptions" tab ─
# Optional. If unset, that tab shows a "not configured" message and the rest
# of the portal works normally. Token is server-side only (never sent to the browser).
RADAR_DB_HOST=https://dbc-xxxxxxxx.cloud.databricks.com
RADAR_DB_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXX
RADAR_WAREHOUSE_ID=your-sql-warehouse-id
# Optional override; defaults to the shared proxy.
# RADAR_PROXY_URL=https://radar-revops.vercel.app
