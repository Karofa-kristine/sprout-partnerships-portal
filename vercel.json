{
  "services": {
    "sprout-partnerships-portal": {
      "root": ".",
      "entrypoint": "server.js",
      "buildCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "sprout-partnerships-portal"
      }
    }
  ]
}
